(vl-load-com) (setq acadObj (vlax-get-acad-object)) (setq doc (vla-get-ActiveDocument acadObj)) (vlax-for layout (vla-get-Layouts doc) (if (= (vla-get-ModelType layout) :vlax-false) (vl-catch-all-apply (function (lambda () (command "_.-PLOT" "_Y" (vla-get-Name layout) "DWG To PDF.pc3" "ISO_full_bleed_A3_(420.00_x_297.00_MM)" "_M" "_L" "_N" "_E" "_F" "_C" "_Y" "." "_Y" "_N" "_N" "_N" (strcat "E:/Temp/" (vla-get-Name layout) ".pdf") "_N" "_Y") ))))) (command "_.QUIT" "_Y")
