(vl-load-com) (setq acadObj (vlax-get-acad-object)) (setq doc (vla-get-ActiveDocument acadObj)) (vlax-for layout (vla-get-Layouts doc) (if (= (vla-get-ModelType layout) :vlax-false) (vl-catch-all-apply (function (lambda () (vla-put-ConfigName layout "DWG To PDF.pc3") (vla-RefreshPlotDeviceInfo layout) (vla-put-CanonicalMediaName layout "ISO_full_bleed_A3_(420.00_x_297.00_MM)") (vla-put-PlotType layout 1) (vla-put-StandardScale layout 0) (vla-put-CenterPlot layout :vlax-true) ))))) (setvar "TILEMODE" 0) (command "_.-EXPORT" "_PDF" "_All" "E:/Temp/test_media.pdf") (command "_.QUIT" "_Y")
