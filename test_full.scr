(setvar "FILEDIA" 0) (setvar "CMDDIA" 0) (setvar "PROXYNOTICE" 0) (setvar "EXPERT" 5) (vl-catch-all-apply 'setvar (list "PDFSHX" 0)) (vl-catch-all-apply 'setvar (list "EPDFSHX" 0)) (vl-catch-all-apply 'setenv (list "PrinterStyleSheetDir" "C:\\Common\\Plot_Styles")) (setq curacad (getenv "ACAD")) (if (not (vl-string-search "C:\\Common\\Fonts" curacad)) (vl-catch-all-apply 'setenv (list "ACAD" (strcat "C:\\Common\\Fonts;" curacad)))) (setvar "TILEMODE" 0) (command "_.-EXPORT" "_PDF" "_All" "E:/Temp/test_export.pdf") (command "_.QUIT" "_Y")
