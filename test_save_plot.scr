(setq laydict (dictsearch (namedobjdict) "ACAD_LAYOUT")) (foreach item laydict (if (= (car item) 3) (if (not (= (cdr item) "Model")) (vl-catch-all-apply (function (lambda () (command "_.-PLOT" "_Y" (cdr item) "DWG To PDF.pc3" "ISO_full_bleed_A3_(420.00_x_297.00_MM)" "_M" "_L" "_N" "_E" "_F" "_C" "_Y" "." "_Y" "_N" "_N" "_N" "E:/Temp/dummy.pdf" "_Y" "_N") )))))) (setvar "TILEMODE" 0) (command "_.-EXPORT" "_PDF" "_All" "E:/Temp/test_export_fixed.pdf") (command "_.QUIT" "_Y")
